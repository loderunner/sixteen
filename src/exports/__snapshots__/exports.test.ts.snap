exports[`CSS export > is pinned for one palette 1`] = `
"/* Harbor, generated by Nord-like from #7ab4c8 (https://example.com/7ab4c8). */

:root {
  --harbor-dark-surface-0: #28313c;
  --harbor-dark-surface-1: #34404d;
  --harbor-dark-surface-2: #3c4a5a;
  --harbor-dark-surface-3: #4b5b6e;
  --harbor-dark-ink-0: #d5dde7;
  --harbor-dark-ink-1: #e2e9ef;
  --harbor-dark-ink-2: #edf1f5;
  --harbor-dark-hue-0: #80b1b3;
  --harbor-dark-hue-1: #7ab4c8;
  --harbor-dark-hue-2: #7695b8;
  --harbor-dark-hue-3: #5774a3;
  --harbor-dark-signal-red: #c46668;
  --harbor-dark-signal-orange: #d28a69;
  --harbor-dark-signal-yellow: #e9ca87;
  --harbor-dark-signal-green: #9cbf8c;
  --harbor-dark-signal-rare: #ae8eb6;

  --harbor-light-surface-0: #f3f7fc;
  --harbor-light-surface-1: #e8eef5;
  --harbor-light-surface-2: #dbe3ec;
  --harbor-light-surface-3: #798899;
  --harbor-light-ink-0: #303d4c;
  --harbor-light-ink-1: #232f3c;
  --harbor-light-ink-2: #18212c;
  --harbor-light-hue-0: #3f7679;
  --harbor-light-hue-1: #32758a;
  --harbor-light-hue-2: #55789d;
  --harbor-light-hue-3: #6082b7;
  --harbor-light-signal-red: #c35a5e;
  --harbor-light-signal-orange: #aa5d39;
  --harbor-light-signal-yellow: #7d5e00;
  --harbor-light-signal-green: #4f733e;
  --harbor-light-signal-rare: #896791;
}

:root,
[data-theme='light'] {
  color-scheme: light;
  --surface-0: var(--harbor-light-surface-0);
  --surface-1: var(--harbor-light-surface-1);
  --surface-2: var(--harbor-light-surface-2);
  --surface-3: var(--harbor-light-surface-3);
  --ink-0: var(--harbor-light-ink-0);
  --ink-1: var(--harbor-light-ink-1);
  --ink-2: var(--harbor-light-ink-2);
  --hue-0: var(--harbor-light-hue-0);
  --hue-1: var(--harbor-light-hue-1);
  --hue-2: var(--harbor-light-hue-2);
  --hue-3: var(--harbor-light-hue-3);
  --signal-red: var(--harbor-light-signal-red);
  --signal-orange: var(--harbor-light-signal-orange);
  --signal-yellow: var(--harbor-light-signal-yellow);
  --signal-green: var(--harbor-light-signal-green);
  --signal-rare: var(--harbor-light-signal-rare);
}

@media (prefers-color-scheme: dark) {
  :root:not([data-theme='light']) {
    color-scheme: dark;
    --surface-0: var(--harbor-dark-surface-0);
    --surface-1: var(--harbor-dark-surface-1);
    --surface-2: var(--harbor-dark-surface-2);
    --surface-3: var(--harbor-dark-surface-3);
    --ink-0: var(--harbor-dark-ink-0);
    --ink-1: var(--harbor-dark-ink-1);
    --ink-2: var(--harbor-dark-ink-2);
    --hue-0: var(--harbor-dark-hue-0);
    --hue-1: var(--harbor-dark-hue-1);
    --hue-2: var(--harbor-dark-hue-2);
    --hue-3: var(--harbor-dark-hue-3);
    --signal-red: var(--harbor-dark-signal-red);
    --signal-orange: var(--harbor-dark-signal-orange);
    --signal-yellow: var(--harbor-dark-signal-yellow);
    --signal-green: var(--harbor-dark-signal-green);
    --signal-rare: var(--harbor-dark-signal-rare);
  }
}

[data-theme='dark'] {
  color-scheme: dark;
  --surface-0: var(--harbor-dark-surface-0);
  --surface-1: var(--harbor-dark-surface-1);
  --surface-2: var(--harbor-dark-surface-2);
  --surface-3: var(--harbor-dark-surface-3);
  --ink-0: var(--harbor-dark-ink-0);
  --ink-1: var(--harbor-dark-ink-1);
  --ink-2: var(--harbor-dark-ink-2);
  --hue-0: var(--harbor-dark-hue-0);
  --hue-1: var(--harbor-dark-hue-1);
  --hue-2: var(--harbor-dark-hue-2);
  --hue-3: var(--harbor-dark-hue-3);
  --signal-red: var(--harbor-dark-signal-red);
  --signal-orange: var(--harbor-dark-signal-orange);
  --signal-yellow: var(--harbor-dark-signal-yellow);
  --signal-green: var(--harbor-dark-signal-green);
  --signal-rare: var(--harbor-dark-signal-rare);
}
"
`;

exports[`Tailwind CSS 4 export > is pinned for one palette 1`] = `
"/* Harbor, generated by Nord-like from #7ab4c8 (https://example.com/7ab4c8).
   Import after tailwindcss: @import "./harbor.tailwind.css"; */

@theme {
  --color-harbor-dark-surface-0: #28313c;
  --color-harbor-dark-surface-1: #34404d;
  --color-harbor-dark-surface-2: #3c4a5a;
  --color-harbor-dark-surface-3: #4b5b6e;
  --color-harbor-dark-ink-0: #d5dde7;
  --color-harbor-dark-ink-1: #e2e9ef;
  --color-harbor-dark-ink-2: #edf1f5;
  --color-harbor-dark-hue-0: #80b1b3;
  --color-harbor-dark-hue-1: #7ab4c8;
  --color-harbor-dark-hue-2: #7695b8;
  --color-harbor-dark-hue-3: #5774a3;
  --color-harbor-dark-signal-red: #c46668;
  --color-harbor-dark-signal-orange: #d28a69;
  --color-harbor-dark-signal-yellow: #e9ca87;
  --color-harbor-dark-signal-green: #9cbf8c;
  --color-harbor-dark-signal-rare: #ae8eb6;

  --color-harbor-light-surface-0: #f3f7fc;
  --color-harbor-light-surface-1: #e8eef5;
  --color-harbor-light-surface-2: #dbe3ec;
  --color-harbor-light-surface-3: #798899;
  --color-harbor-light-ink-0: #303d4c;
  --color-harbor-light-ink-1: #232f3c;
  --color-harbor-light-ink-2: #18212c;
  --color-harbor-light-hue-0: #3f7679;
  --color-harbor-light-hue-1: #32758a;
  --color-harbor-light-hue-2: #55789d;
  --color-harbor-light-hue-3: #6082b7;
  --color-harbor-light-signal-red: #c35a5e;
  --color-harbor-light-signal-orange: #aa5d39;
  --color-harbor-light-signal-yellow: #7d5e00;
  --color-harbor-light-signal-green: #4f733e;
  --color-harbor-light-signal-rare: #896791;
}

@theme inline {
  --color-surface-0: var(--surface-0);
  --color-surface-1: var(--surface-1);
  --color-surface-2: var(--surface-2);
  --color-surface-3: var(--surface-3);
  --color-ink-0: var(--ink-0);
  --color-ink-1: var(--ink-1);
  --color-ink-2: var(--ink-2);
  --color-hue-0: var(--hue-0);
  --color-hue-1: var(--hue-1);
  --color-hue-2: var(--hue-2);
  --color-hue-3: var(--hue-3);
  --color-signal-red: var(--signal-red);
  --color-signal-orange: var(--signal-orange);
  --color-signal-yellow: var(--signal-yellow);
  --color-signal-green: var(--signal-green);
  --color-signal-rare: var(--signal-rare);
}

:root,
[data-theme='light'] {
  --surface-0: var(--color-harbor-light-surface-0);
  --surface-1: var(--color-harbor-light-surface-1);
  --surface-2: var(--color-harbor-light-surface-2);
  --surface-3: var(--color-harbor-light-surface-3);
  --ink-0: var(--color-harbor-light-ink-0);
  --ink-1: var(--color-harbor-light-ink-1);
  --ink-2: var(--color-harbor-light-ink-2);
  --hue-0: var(--color-harbor-light-hue-0);
  --hue-1: var(--color-harbor-light-hue-1);
  --hue-2: var(--color-harbor-light-hue-2);
  --hue-3: var(--color-harbor-light-hue-3);
  --signal-red: var(--color-harbor-light-signal-red);
  --signal-orange: var(--color-harbor-light-signal-orange);
  --signal-yellow: var(--color-harbor-light-signal-yellow);
  --signal-green: var(--color-harbor-light-signal-green);
  --signal-rare: var(--color-harbor-light-signal-rare);
}

@media (prefers-color-scheme: dark) {
  :root:not([data-theme='light']) {
    --surface-0: var(--color-harbor-dark-surface-0);
    --surface-1: var(--color-harbor-dark-surface-1);
    --surface-2: var(--color-harbor-dark-surface-2);
    --surface-3: var(--color-harbor-dark-surface-3);
    --ink-0: var(--color-harbor-dark-ink-0);
    --ink-1: var(--color-harbor-dark-ink-1);
    --ink-2: var(--color-harbor-dark-ink-2);
    --hue-0: var(--color-harbor-dark-hue-0);
    --hue-1: var(--color-harbor-dark-hue-1);
    --hue-2: var(--color-harbor-dark-hue-2);
    --hue-3: var(--color-harbor-dark-hue-3);
    --signal-red: var(--color-harbor-dark-signal-red);
    --signal-orange: var(--color-harbor-dark-signal-orange);
    --signal-yellow: var(--color-harbor-dark-signal-yellow);
    --signal-green: var(--color-harbor-dark-signal-green);
    --signal-rare: var(--color-harbor-dark-signal-rare);
  }
}

[data-theme='dark'] {
  --surface-0: var(--color-harbor-dark-surface-0);
  --surface-1: var(--color-harbor-dark-surface-1);
  --surface-2: var(--color-harbor-dark-surface-2);
  --surface-3: var(--color-harbor-dark-surface-3);
  --ink-0: var(--color-harbor-dark-ink-0);
  --ink-1: var(--color-harbor-dark-ink-1);
  --ink-2: var(--color-harbor-dark-ink-2);
  --hue-0: var(--color-harbor-dark-hue-0);
  --hue-1: var(--color-harbor-dark-hue-1);
  --hue-2: var(--color-harbor-dark-hue-2);
  --hue-3: var(--color-harbor-dark-hue-3);
  --signal-red: var(--color-harbor-dark-signal-red);
  --signal-orange: var(--color-harbor-dark-signal-orange);
  --signal-yellow: var(--color-harbor-dark-signal-yellow);
  --signal-green: var(--color-harbor-dark-signal-green);
  --signal-rare: var(--color-harbor-dark-signal-rare);
}
"
`;

