  --color-harbor-dark-hue-3: #5774a3;
  --color-harbor-dark-signal-red: #c46668;
  --color-harbor-dark-signal-orange: #d28a69;
  --color-harbor-dark-signal-yellow: #e9ca87;
  --color-harbor-dark-signal-green: #9cbf8c;
  --color-harbor-dark-signal-rare: #ae8eb6;

  --color-harbor-light-surface-0: #f3f7fc;
  --color-harbor-light-surface-1: #e8eef5;
  --color-harbor-light-surface-2: #dbe3ec;
