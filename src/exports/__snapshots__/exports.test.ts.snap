"/* Harbor, generated by Nord-like from #7ab4c8 (https://example.com/7ab4c8).
   Import after tailwindcss: @import "./harbor.tailwind.css"; */

@theme {
  --color-harbor-dark-surface-0: #28313c;
  --color-harbor-dark-surface-1: #34404d;
